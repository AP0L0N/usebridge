APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Bridge: keep log until The Many confirms SMTP + DNS for usebridge.si (verification / reset mails go to the mail log only, nothing is sent).
# Sender from MAIL_FROM_ADDRESS / MAIL_FROM_NAME; empty falls back to support@usebridge.si / "Bridge".
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=support@usebridge.si
MAIL_FROM_NAME="Bridge"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AUTH-1 shared workspace gate (transitional): set explicitly; empty = gate rejects everyone
BRIDGE_GATE_PASSWORD=
# false = the gate is retired (/gate 404s, gate sessions unlock nothing; everyone logs in)
BRIDGE_GATE_ENABLED=true
# Label of the waiting_tilen column on workspaces that existed when migration 2026_10_31_160000 ran (empty = derived
# from the default workspace owner's first name). New workspaces always show "Waiting on you".
BRIDGE_OWNER_WAITING_LABEL=
# Bridge r1 migration: false = start clean (no carried-over inputs)
BRIDGE_R1_CARRY_OVER=true

# Multi-user (docs/MULTI-USER-PLAN.md): new API tokens start with this prefix (existing tokens keep working).
SANCTUM_TOKEN_PREFIX=brg_live_
# Owner (login email) of the backfilled workspace; required before the multi-user migrations run.
BRIDGE_OWNER_EMAIL=
# Email of the API user created by BridgeApiSeeder (empty = captain@example.test).
BRIDGE_API_USER_EMAIL=
# Slug and name of the backfilled workspace (an already migrated database keeps its slug: set it here).
BRIDGE_WORKSPACE_SLUG=main
BRIDGE_WORKSPACE_NAME="My workspace"
# Public URL for ticket links in API payloads (empty = APP_URL).
BRIDGE_PUBLIC_URL=
# Host of the live Bridge; bridge:rotate-copied-tokens refuses an APP_URL with this host (empty = no host check).
BRIDGE_LIVE_HOST=
# Roster JSON outside the repo: {"agents": {"agent-id": ["Name", "Role"]}, "pms": {"project-id": "agent-id"},
# "ticket_prefixes": {"project-id": "AB"}} (ticket_prefixes optional). Empty / missing / invalid = empty roster.
BRIDGE_ROSTER_PATH=
# Cloudflare Turnstile on sign-up; empty secret = no Turnstile (honeypot + fill time still apply). The script loads only
# when the form is submitted. Keep the widget's "Pre-clearance" setting OFF in the Cloudflare dashboard (no cf_clearance cookie).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Legal: footer operator name, terms version stored at sign-up, directory with the final legal texts (outside the repo;
# empty = placeholders in resources/legal), and the AGPL source link (+ /tree/<sha> when the deployed commit is set).
BRIDGE_LEGAL_ENTITY="Your company"
BRIDGE_TERMS_VERSION=2026-10-draft
BRIDGE_LEGAL_DIR=
BRIDGE_SOURCE_URL=https://github.com/AP0L0N/usebridge
# Deployed commit for the source link (7–40 hex); empty = the file .bridge-deploy-sha if present. BRIDGE_SOURCE_SHA wins.
BRIDGE_DEPLOYED_SHA=
BRIDGE_SOURCE_SHA=
APP_TIMEZONE=Europe/Ljubljana

# Production MySQL example:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bridge
# DB_USERNAME=bridge
# DB_PASSWORD=
